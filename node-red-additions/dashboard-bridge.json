[
  {
    "id": "dashboard_bridge_tab",
    "type": "tab",
    "label": "Dashboard Bridge",
    "disabled": false,
    "info": "Bridges the PyQt5 Windows dashboard to MISSION 1 / MISSION 2 over two WebSocket channels: /dashboard/control (commands in) and /dashboard/status (events out). All wires into/out of the existing MISSION 1 / MISSION 2 tabs were added without touching any existing node or wire -- see README for the exact tap points used."
  },
  {
    "id": "control_ws_listener",
    "type": "websocket-listener",
    "path": "/dashboard/control",
    "wholemsg": "false"
  },
  {
    "id": "status_ws_listener",
    "type": "websocket-listener",
    "path": "/dashboard/status",
    "wholemsg": "false"
  },
  {
    "id": "link_in_status",
    "type": "link in",
    "z": "dashboard_bridge_tab",
    "name": "Dashboard Status In",
    "links": [],
    "x": 140,
    "y": 40,
    "wires": [
      [
        "format_status_json"
      ]
    ]
  },
  {
    "id": "format_status_json",
    "type": "function",
    "z": "dashboard_bridge_tab",
    "name": "Format status JSON",
    "func": "msg.payload = JSON.stringify(msg.payload);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 40,
    "wires": [
      [
        "ws_out_status"
      ]
    ]
  },
  {
    "id": "ws_out_status",
    "type": "websocket out",
    "z": "dashboard_bridge_tab",
    "name": "Dashboard Status Out",
    "server": "status_ws_listener",
    "client": "",
    "x": 560,
    "y": 40
  },
