  {
    "id": "tag_m2_ocr",
    "type": "function",
    "z": "dashboard_bridge_tab",
    "name": "Tag M2 OCR result",
    "func": "var text = msg.payload;\nif (text && typeof text === 'object') {\n  text = text.text || (text.result && text.result.text) || JSON.stringify(text);\n}\nmsg.payload = {mission: 2, event: 'ocr_result', text: text};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 140,
    "y": 790,
    "wires": [
